// include/secrets.h.example
// Copy this file to include/secrets.h and fill in your own Wi-Fi credentials.
// secrets.h is listed in .gitignore and must never be committed.
#ifndef SECRETS_H
#define SECRETS_H

// Primary network
const char* SECRET_SSID = "your-wifi-name";
const char* SECRET_PASSWORD = "your-wifi-password";

// Fallback network (e.g. phone hotspot). Use the same values as above
// if you only have one network.
const char* SECRET_SSID_2 = "your-second-wifi-name";
const char* SECRET_PASSWORD_2 = "your-second-wifi-password";

#endif